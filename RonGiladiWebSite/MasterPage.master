<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>

    <style>
        body {
            background-color: #f0f0f0;
            font-family: Arial, sans-serif;
        }

        table.a {
            width: 90%;
            height: 800px;
            border: 2px solid #333333;
            border-collapse: collapse;
            background-color: #ffffff;
        }

        table td {
            border: 1px solid #aaaaaa;
            padding: 10px;
            vertical-align: top;
        }

        h1 {
            color: #2c3e50;
            margin: 0;
            padding: 20px 0;
        }

        #menu h2 {
            color: #2c3e50;
        }

        #menu a img {
            width: 80px;
            border: 1px solid #ccc;
            padding: 2px;
            transition: 0.2s;
        }

        #menu a img:hover {
            border-color: #2c3e50;
            cursor: pointer;    
        }

        .logo-style {
            width: 360px;
            height: auto;
            display: block;
        }

        .search-box {
            margin-right: 20px;
            text-align: right;
        }

        .search-box input {
            padding: 5px;
            font-size: 14px;
        }

        .search-box button {
            padding: 5px 10px;
            cursor: pointer;
        }
        
        /* עיצוב בסיסי לטבלת התוצאות */
        .search-results-grid {
            margin-top: 10px;
            background-color: white;
            border: 1px solid #ccc;
        }
    </style>
</head>

<body dir="rtl">
<center>

<table class="a">

    <!-- כותרת -->
    <tr height="100px"> 
        <td align="right" valign="middle" style="width: 150px;"> 
            <img src="Images/logo.png" class="logo-style" alt="Logo" />
        </td>

        <td align="left" valign="middle">

            <div style="display:flex; justify-content:space-between; align-items:center;">

                <h1>Ron giladi's website</h1>

                <!-- 🔎 סרגל חיפוש ותוצאות החיפוש המחוברות אליו -->
                <div class="search-box">
                    <%-- התיקון: הטופס עוטף רק את אזור החיפוש ולא מפריע לדפים אחרים --%>
                    <form id="searchForm" runat="server">
                        <div>
                            <asp:TextBox ID="txtSearch" runat="server" />
                            <asp:Button ID="btnSearch" runat="server" Text="חפש" OnClick="btnSearch_Click" />
                        </div>
                        
                        <asp:GridView ID="gvResults" runat="server" AutoGenerateColumns="true" CssClass="search-results-grid" Width="100%"></asp:GridView>
                    </form>
                </div>

            </div>

        </td>
    </tr>

    <tr>

        <!-- תוכן -->
        <td valign="top">
            <asp:ContentPlaceHolder id="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </td>

        <!-- תפריט -->
        <td id="menu" width="15%" valign="top" align="center">

            <h2>ניווט</h2><br />

            <a href="HomePage.aspx"><img src="Images/דף הבית תמונה.png" /></a><br /><br />
            <a href="גלריה.aspx"><img src="Images/גלריה.png" /></a><br /><br />
            <a href="form.aspx"><img src="Images/Forms.aspx תמונה.png" /></a><br /><br />
            <a href="makingCotact.aspx"><img src="Images/יצירת קשר תמונה.png" /></a><br /><br />
            <a href="מדיניות.aspx"><img src="Images/מדיניות פרטיות תמונה.png" /></a><br /><br />
            <a href="AddArticle.aspx"><img src="Images/דף כתבה לדוגמא.png" /></a><br /><br />

            <% if (Session["nihol"] != "ok" && Session["user"] != "ok")
               { %>
                <a href="דף התחברות.aspx"><img src="Images/דף התחברות תמונה.png" /></a><br /><br />
                <a href="login.aspx"><img src="Images/דף login.png" /></a><br /><br />
            <% } %>

            <% if (Session["nihol"] == "ok" || Session["user"] == "ok")
               { %>
                <br /><br />
                <a href="logout.aspx"><img src="Images/התנתקות.png" /></a><br /><br />
            <% } %>

        </td>
    </tr>

    <!-- שורת שלום -->
    <tr>
        <% if (Session["nihol"] == "ok" || Session["user"] == "ok")
           { %>
            <td colspan="2" align="center">
                שלום <%= Session["name"] %>
            </td>
        <% } %>
    </tr>

</table>

</center>
</body>
</html>
